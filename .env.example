# ─── Supabase ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=tnr-media

# ─── Admin / security ─────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string

# ─── Phone / OTP ──────────────────────────────────────────────────────────
DEFAULT_COUNTRY_CODE=92
# OTP delivery: "whatsapp" (free self-hosted) | "twilio" | "dev"
OTP_PROVIDER=whatsapp
WHATSAPP_SERVICE_URL=http://localhost:4000
WA_API_KEY=change_this_key

# ─── Twilio (only if OTP_PROVIDER=twilio) ─────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_SMS_FROM=+10000000000
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Tehreek Naujawanan Roundu
NEXT_PUBLIC_APP_SHORT=TNR
NEXT_PUBLIC_ELECTION_YEAR=2026
